{
  "uid": "homelab-logs",
  "title": "Homelab / Logs",
  "tags": ["homelab", "logs"],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "30s",
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Machine",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values(host)",
        "query": { "label": "host", "refId": "LokiVariableQueryEditor-VariableQuery", "stream": "", "type": 1 },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      },
      {
        "name": "search",
        "label": "Recherche",
        "type": "textbox",
        "query": "",
        "current": { "selected": false, "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Machines actives",
      "description": "Machines qui ont envoyé au moins un log pendant la dernière heure. Rouge si aucune.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "count(sum by (host) (count_over_time({host=~\"$host\"}[1h]))) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Logs sur 1 h",
      "description": "Nombre total de lignes de logs reçues pendant la dernière heure.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({host=~\"$host\"}[1h])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Erreurs sur 1 h",
      "description": "Lignes contenant error, erreur, fatal, critical, panic, failed ou denied sur la dernière heure. Les requêtes de ce tableau de bord sont exclues du compte. Vert : 0. Orange : 10 ou plus. Rouge : 100 ou plus.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({host=~\"$host\"} |~ \"(?i)(error|erreur|fatal|critical|panic|failed|denied)\" !~ \"caller=spanlogger|caller=scheduler_processor|logger=plugin.loki|Request Completed|count_over_time\" [1h])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Erreurs, 5 dernières minutes",
      "description": "Même compte que ci-contre, mais sur 5 minutes : montre ce qui se passe en ce moment. Orange : 1 ou plus. Rouge : 20 ou plus.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({host=~\"$host\"} |~ \"(?i)(error|erreur|fatal|critical|panic|failed|denied)\" !~ \"caller=spanlogger|caller=scheduler_processor|logger=plugin.loki|Request Completed|count_over_time\" [5m])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Volume de logs par machine",
      "description": "Nombre de lignes de logs reçues, machine par machine. Un pic isolé signale souvent un service qui s'emballe.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (count_over_time({host=~\"$host\"}[$__auto]))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Erreurs par machine",
      "description": "Lignes d'erreur au fil du temps, machine par machine. Les requêtes de ce tableau de bord sont exclues.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (count_over_time({host=~\"$host\"} |~ \"(?i)(error|erreur|fatal|critical|panic|failed|denied)\" !~ \"caller=spanlogger|caller=scheduler_processor|logger=plugin.loki|Request Completed|count_over_time\" [$__auto]))",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Sources les plus bavardes",
      "description": "Les 10 services (ou conteneurs Docker) qui produisent le plus de lignes sur la période affichée.",
      "gridPos": { "h": 9, "w": 10, "x": 0, "y": 11 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "topk(10, sum by (host, unit, container) (count_over_time({host=~\"$host\"}[$__range])))",
          "legendFormat": "{{host}} / {{unit}}{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "namePlacement": "top",
        "valueMode": "text",
        "showUnfilled": true,
        "minVizHeight": 16,
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Dernières erreurs",
      "description": "Les erreurs les plus récentes, avec la machine et le service au début de chaque ligne.",
      "gridPos": { "h": 9, "w": 14, "x": 10, "y": 11 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\"} |~ \"(?i)(error|erreur|fatal|critical|panic|failed|denied)\" !~ \"caller=spanlogger|caller=scheduler_processor|logger=plugin.loki|Request Completed|count_over_time\" | line_format \"[{{.host}}] {{.unit}}{{.container}} : {{__line__}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Tous les logs (le champ Recherche en haut filtre les lignes)",
      "description": "Toutes les lignes, la plus récente en premier. Chaque ligne commence par la machine et le service. Tape un mot dans Recherche pour filtrer.",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\"} |~ \"(?i)$search\" | line_format \"[{{.host}}] {{.unit}}{{.container}} : {{__line__}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}
